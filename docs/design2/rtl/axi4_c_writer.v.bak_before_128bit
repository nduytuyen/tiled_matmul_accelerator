  always @(posedge clk_i) begin
    if (!rst_ni) begin
      state_q         <= ST_IDLE;
      c_write_done_o  <= 1'b0;
      m_axi_awvalid_o <= 1'b0;
      m_axi_wvalid_o  <= 1'b0;
      m_axi_bready_o  <= 1'b0;
    end else begin
      case (state_q)
        ST_IDLE: begin
          // Tile moi bat dau (mmult_accel vua duoc AXI4_C_WRITER bao da
          // ghi xong tile truoc, gio no chot tham so cho tile nay va bao
          // tile_valid_i) -> ha "done" cu, cho tile_done_i cua tile nay.
          if (tile_valid_i) begin
            c_write_done_o <= 1'b0;
          end

          if (tile_done_i) begin
            ii_q               <= 0;
            jj_q               <= 0;
            valid_rows_q       <= c_valid_rows_i;
            valid_cols_q       <= c_valid_cols_i;
            row_stride_bytes_q <= c_row_stride_i << 2;
            row_base_addr_q    <= c_base_addr_i
                                   + (c_global_i0_i * c_row_stride_i + c_global_j0_i) * 4;
            if (c_valid_rows_i == 0 || c_valid_cols_i == 0) begin
              state_q <= ST_DONE;
            end else begin
              state_q <= ST_AW;
            end
          end
        end

        // [SUA - 2026-08-23] AW phat 1 lan/hang (khong phai 1 lan/phan tu):
        // dia chi luon la dau hang (jj_q=0 tai day, xem ST_B), AWLEN gop het
        // valid_cols_q phan tu lien tiep cua hang thanh 1 burst.
        //
        // [BUGFIX - 2026-08-23, phat hien qua Verification feedback] Nap san
        // wdata_o/wlast_o cho BEAT DAU TIEN (jj=0) NGAY TAI DAY (luc AWREADY
        // handshake), thay vi de ST_W tu doc to hop moi cycle - tranh dung
        // lai loi da gap trong chinh ST_W (xem comment o duoi).
        ST_AW: begin
          m_axi_awaddr_o  <= row_base_addr_q;
          m_axi_awlen_o   <= valid_cols_q - 1'b1;  // gop ca hang thanh 1 burst
          m_axi_awsize_o  <= 3'b010;  // 4 byte/beat
          m_axi_awburst_o <= 2'b01;   // INCR
          m_axi_awvalid_o <= 1'b1;
          if (m_axi_awvalid_o && m_axi_awready_i) begin
            m_axi_awvalid_o <= 1'b0;
            m_axi_wdata_o   <= c_arr_flat[ii_q*ARR_SIZE];  // beat jj=0
            m_axi_wlast_o   <= (valid_cols_q == 16'd1);    // hang chi 1 phan tu
            m_axi_wstrb_o   <= 4'b1111;
            // [BUGFIX - 2026-08-23 lan 2, Verification PROBE1] wstrb_o phai
            // nap truoc CUNG luc voi wdata_o/wlast_o/wvalid_o o day - truoc
            // day chi gan trong ST_W (vo dieu kien moi cycle), nhung vi
            // handshake W DAU TIEN xay ra NGAY cycle dau tien cua ST_W (do
            // wvalid_o da san sang tu day), wstrb_o luc do van la gia tri cu/
            // chua xac dinh (X sau reset) - mat dung byte dau tien cua LAN
            // GHI DAU TIEN trong ca mo phong (tu beat thu 2 tro di, wstrb_o
            // "giu" duoc 4'b1111 tu ST_W truoc do nen khong lo).
            m_axi_wvalid_o  <= 1'b1;
            state_q         <= ST_W;
          end
        end

        // [BUGFIX - 2026-08-23] Ban truoc: "m_axi_wdata_o <= cur_elem;" (to
        // hop tu jj_q) bi ghi de MOI CYCLE VO DIEU KIEN, trong khi jj_q chi
        // tang tai handshake CUNG edge - ket qua wdata_o/wlast_o trinh bay
        // tren bus luon CHAM HON dung 1 buoc so voi jj_q that (Verification
        // xac nhan bang so: got[jj]=expected[jj-1] cho moi jj>=1). WLAST bi
        // lech tuong tu khien no len 1 dung luc wvalid da ve 0 (roi ST_W) -
        // BFM cho mai khong thay beat cuoi co WLAST hop le -> TIMEOUT.
        //
        // Sua bang ky thuat "nap truoc" (prefetch): CHI nap wdata_o/wlast_o
        // cho beat KE TIEP dung luc handshake beat hien tai xay ra (khong
        // con doc to hop moi cycle vo dieu kien) - dam bao du lieu tren bus
        // tai 1 interval bat ky luon dung khop jj_q dang dung de so sanh.
        ST_W: begin
          m_axi_wstrb_o <= 4'b1111;
          if (m_axi_wvalid_o && m_axi_wready_i) begin
            if (jj_q == valid_cols_q - 1'b1) begin
              m_axi_wvalid_o <= 1'b0;
              m_axi_bready_o <= 1'b1;
              state_q        <= ST_B;
            end else begin
              jj_q           <= jj_q + 1'b1;
              m_axi_wdata_o  <= c_arr_flat[ii_q*ARR_SIZE + jj_q + 1'b1];  // beat KE TIEP
              m_axi_wlast_o  <= ((jj_q + 1'b1) == valid_cols_q - 1'b1);
              // m_axi_wvalid_o giu nguyen = 1 (back-to-back, khong can gan lai)
            end
          end
        end

        // [SUA - 2026-08-23] Chi con 1 BRESP/hang (khong phai 1 BRESP/phan
        // tu) - luon reset jj_q=0 cho hang ke tiep (hoac ket thuc).
        ST_B: begin
          if (m_axi_bvalid_i && m_axi_bready_o) begin
            m_axi_bready_o <= 1'b0;
            jj_q           <= 0;
            if (ii_q == valid_rows_q - 1) begin
              state_q <= ST_DONE;
            end else begin
              ii_q            <= ii_q + 1'b1;
              row_base_addr_q <= row_base_addr_q + row_stride_bytes_q;
              state_q         <= ST_AW;
            end
          end
        end

        ST_DONE: begin
          c_write_done_o <= 1'b1;
          state_q        <= ST_IDLE;
        end

        default: state_q <= ST_IDLE;
      endcase
    end
  end

